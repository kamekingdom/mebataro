rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          'Z2YLjPzwFEWGtWVs8BHhvb43bQI3',
          'w41JQF9EuDcLL2pfMpbDuI5q6Eh1'
        ];
    }

    function validRecipe() {
      return request.resource.data.keys().hasOnly([
          'title', 'category', 'time', 'servings', 'ingredients', 'steps',
          'note', 'icon', 'color', 'imageUrl', 'sourceFile',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.category in ['ごはん', 'おかず', 'おやつ', 'その他']
        && request.resource.data.time is string
        && request.resource.data.servings is string
        && request.resource.data.ingredients is list
        && request.resource.data.ingredients.size() <= 100
        && request.resource.data.steps is list
        && request.resource.data.steps.size() <= 100
        && request.resource.data.note is string
        && request.resource.data.icon is string
        && request.resource.data.color is string
        && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string)
        && (!('sourceFile' in request.resource.data) || request.resource.data.sourceFile is string);
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow create, update: if isAdmin() && validRecipe();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
